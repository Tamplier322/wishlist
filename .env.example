# Порт API
PORT=4000

# Секрет для JWT и подписанных ссылок на загрузки.
# В проде обязателен: случайная строка не короче 32 символов.
JWT_SECRET=dev-secret-change-me
# Access-токен живёт недолго, клиент обновляет его через /api/auth/refresh
JWT_ACCESS_EXPIRES_IN=15m
# Срок жизни refresh-токена (дни)
JWT_REFRESH_DAYS=30

# Разрешённые origin (через запятую)
CORS_ORIGINS=http://localhost:5173

# --- Публичные адреса и OAuth -------------------------------------------
# Куда возвращаем пользователя после входа (фронтенд).
APP_URL=http://localhost:5173
# Адрес API — из него строится redirect_uri для провайдеров.
PUBLIC_API_URL=http://localhost:4000
# На Render эти два адреса и CORS_ORIGINS можно не задавать: если переменные
# пусты, они автоматически берутся из RENDER_EXTERNAL_URL (https://<service>.onrender.com).
# RENDER_EXTERNAL_URL=https://wishlist-xre9.onrender.com

# Google OAuth 2.0 (console.cloud.google.com → Credentials → OAuth client ID)
# Authorized redirect URI: <PUBLIC_API_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login Widget (@BotFather → /setdomain и /setcommands не нужны)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Максимальный возраст подписи Telegram (секунды)
TELEGRAM_AUTH_MAX_AGE_SEC=3600

# Время жизни OAuth state и одноразового кода обмена (мс)
OAUTH_STATE_TTL_MS=600000
OAUTH_EXCHANGE_TTL_MS=120000

# --- База данных ---------------------------------------------------------
# Прод: Firebase Firestore (достаточно одного из вариантов ниже)
# 1) Путь к JSON сервис-аккаунта (локальная разработка, файл в .gitignore):
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# 2) Или JSON целиком одной строкой (для Render/CI):
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
# 3) Или по частям:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Локально без Firebase: SQLite-файл (создаётся сам)
DB_FILE=data/wishlist.db

# Загрузки
UPLOADS_DIR=data/uploads
UPLOADS_URL_TTL_HOURS=168

# Необязательный внешний кеш офферов (Redis REST, формат Upstash).
# Без него используется кеш в памяти процесса.
# REDIS_REST_URL=https://xxx.upstash.io
# REDIS_REST_TOKEN=
OFFERS_CACHE_TTL_MS=300000

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
