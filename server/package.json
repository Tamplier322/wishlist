{
  "name": "wishlist-server",
  "version": "1.0.0",
  "private": true,
  "description": "Wishlist API — Express + TypeScript + Firebase Firestore (SQLite for local/e2e)",
  "main": "dist/index.js",
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:generate": "tsx scripts/generate-client-contracts.mts",
    "contracts:check": "tsx scripts/generate-client-contracts.mts --check"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/sdk-node": "^0.223.2",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react-window": "^2.5.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "@types/react-window": "^1.8.8",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.1.2",
    "zod-to-ts": "^2.1.0"
  }
}
