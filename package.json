{
  "name": "wishlist-app",
  "version": "1.0.0",
  "private": true,
  "description": "Wishlist — вишлист для любых вещей (React + TypeScript + Redux Toolkit + Express + SQLite)",
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "start": "node server/dist/index.js",
    "lint": "eslint \"server/src/**/*.ts\" \"client/src/**/*.ts\" \"client/src/**/*.tsx\" --max-warnings=200",
    "contracts:check": "npm run contracts:check --prefix server",
    "format": "prettier --write \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"server/src/**/__tests__/**/*.ts\" \"server/src/utils/contracts.ts\" \"server/vitest.config.mts\"",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1"
  }
}
